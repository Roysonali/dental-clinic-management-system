# ============================================================
# DensCare Backend — Environment Template
# ============================================================
# Copy this file to `.env` and fill in your own values:
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# NEVER commit the real `.env` — it is gitignored. The values below
# are placeholders; every secret must be set by the operator.
# ============================================================

# ── Database ───────────────────────────────────────────────────
# SQLite (local development):
DATABASE_URL=sqlite:///./test_db.sqlite3
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/denscare

# ── JWT / Authentication ───────────────────────────────────────
# Minimum 32 characters. Use a strong random value in production,
# e.g. generated with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-32-characters-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Password recovery (forgot / reset password) ─────────────────
# Public origin of the frontend application. Password-reset links in
# emails are built from this value — production MUST set the real
# deployment origin (e.g. https://app.denscare.clinic), never localhost.
FRONTEND_BASE_URL=http://localhost:5173

# Reset links expire after this many minutes (default 30).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── File attachments ──────────────────────────────────────────────
# Local directory where uploaded patient-record attachments are stored
# (created lazily). Mount a persistent volume in production.
UPLOAD_DIR=uploads

# Maximum accepted attachment file size in MB (default 10).
MAX_UPLOAD_SIZE_MB=10

# ── Email delivery (password reset) ─────────────────────────────
# The EmailService (backend/app/core/email.py) sends password-reset
# emails over plain SMTP — no provider SDK is required. Leave
# SMTP_HOST empty to disable sending (local development fallback; see
# EMAIL_LOG_RESET_LINKS below).
#
# ── SendGrid (recommended) — https://sendgrid.com ────────────────
# 1. Create an account and an API key (Settings → API Keys).
# 2. Verify a sender (Settings → Sender Authentication): the From
#    address domain must be authenticated before SendGrid delivers.
# 3. Set:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key
SMTP_FROM_EMAIL=no-reply@your-verified-domain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
#
# ── Resend (alternative) — https://resend.com ───────────────────
# Verify the From domain (adds DKIM/SPF/DMARC), create an API key
# (starts with re_), then use:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465                  # implicit TLS
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_your-api-key
#   SMTP_FROM_EMAIL=no-reply@your-verified-domain.com
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
# (Resend also accepts port 587 with SMTP_USE_TLS=true.)
#
# ── SMTP_* reference ─────────────────────────────────────────────
# SMTP_HOST         — SMTP relay hostname. Empty = email disabled.
# SMTP_PORT         — TCP port (1–65535). 587 STARTTLS / 465 implicit TLS.
# SMTP_USERNAME     — Provider login (SendGrid: "apikey"; Resend: "resend").
# SMTP_PASSWORD     — Provider secret (API key). Never hardcode.
# SMTP_FROM_EMAIL   — Verified "From" address. Must be authenticated
#                     with the provider or delivery is rejected.
# SMTP_USE_TLS      — true = STARTTLS on connect (default).
# SMTP_USE_SSL      — true = implicit TLS from the first byte (port 465).
# ──────────────────────────────────────────────────────────────────

# ── Development only ─────────────────────────────────────────────
# When true AND SMTP is not configured, the reset link (which contains
# the raw token) is written to the application log so local developers
# can click it. NEVER enable this in production.
EMAIL_LOG_RESET_LINKS=false
